+/**
+ * Blackdrift: makes Startpage the default search engine, in every region.
+ *
+ * Focus picks its default from Mozilla's region-based search configuration
+ * (bundled list.json, or Remote Settings search-config-v2), which carries
+ * Mozilla partner codes. On the first search-engine load after install, this
+ * adds Startpage as a search engine and selects it as the user's default
+ * through [SearchMiddleware]'s migration hook. It runs once; afterwards the
+ * user can pick or remove any engine. The legacy Focus [delegate] migration
+ * keeps working and an explicit legacy choice still wins.
+ */
+class BlackdriftSearchMigration(
+    private val context: Context,
+    private val delegate: SearchMiddleware.Migration,
+) : SearchMiddleware.Migration {
+
+    override fun getValuesToMigrate(): SearchMiddleware.Migration.MigrationValues? {
+        val legacy = delegate.getValuesToMigrate()
+        val preferences = context.getSharedPreferences(PREF_FILE_BLACKDRIFT_SEARCH, Context.MODE_PRIVATE)
+        if (preferences.getBoolean(PREF_KEY_STARTPAGE_SEEDED, false)) {
+            return legacy
+        }
+
+        preferences.edit {
+            putBoolean(PREF_KEY_STARTPAGE_SEEDED, true)
+        }
+
+        return SearchMiddleware.Migration.MigrationValues(
+            customSearchEngines = legacy?.customSearchEngines.orEmpty() + createStartpage(),
+            defaultSearchEngineName = legacy?.defaultSearchEngineName?.takeIf { it.isNotEmpty() }
+                ?: STARTPAGE_NAME,
+        )
+    }
+
+    private fun createStartpage(): SearchEngine {
+        val png = Base64.decode(STARTPAGE_ICON_PNG_BASE64, Base64.DEFAULT)
+        return createSearchEngine(
+            name = STARTPAGE_NAME,
+            url = STARTPAGE_SEARCH_URL,
+            icon = BitmapFactory.decodeByteArray(png, 0, png.size),
+            suggestUrl = STARTPAGE_SUGGEST_URL,
+            isGeneral = true,
+        )
+    }
+}
