@@ -0,0 +1,93 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.focus.engine
+
+import androidx.annotation.VisibleForTesting
+import java.io.File
+import kotlinx.coroutines.CoroutineDispatcher
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import mozilla.components.browser.state.action.BrowserAction
+import mozilla.components.browser.state.action.CrashAction
+import mozilla.components.browser.state.action.CustomTabListAction
+import mozilla.components.browser.state.action.TabListAction
+import mozilla.components.browser.state.state.BrowserState
+import mozilla.components.lib.state.Middleware
+import mozilla.components.lib.state.Store
+
+/**
+ * Blackdrift: deletes the crash dumps Gecko writes when a process crashes.
+ *
+ * Gecko's native crash reporter stays installed, because GeckoView only reports a content-process crash as a crash
+ * (and so shows the tab-crash screen) when a minidump was written; without one the crash looks like an OOM kill
+ * and the tab silently reloads, which loops on a page that crashes every time. Blackdrift never uploads these files
+ * (patch 0102), so they are only leftover browsing data: the `.extra` file holds the crashed page's URL.
+ *
+ * Only the files are deleted. The directories stay, so Gecko can write the next dump.
+ *
+ * @param scope Scope the deletion runs in.
+ * @param dispatcher Dispatcher for the file I/O.
+ * @param filesDir Returns the app's private files directory (`Context.getFilesDir()`).
+ */
+class CrashDumpCleaner(
+    private val scope: CoroutineScope,
+    private val dispatcher: CoroutineDispatcher = Dispatchers.IO,
+    private val filesDir: () -> File,
+) {
+    /** Deletes every pending crash dump in the background. */
+    fun cleanCrashDumps() {
+        scope.launch(dispatcher) { deleteCrashDumps() }
+    }
+
+    /** Deletes every pending crash dump on the calling thread. */
+    @VisibleForTesting
+    internal fun deleteCrashDumps() {
+        dumpDirectories().forEach { dir -> dir.listFiles()?.forEach { it.deleteRecursively() } }
+    }
+
+    @VisibleForTesting
+    internal fun dumpDirectories(): List<File> {
+        val root = filesDir()
+        val crashReports = File(root, "mozilla/Crash Reports")
+        return listOf(
+            // Minidumps (.dmp) and their metadata (.extra, with the page URL) waiting for an upload that never
+            // happens.
+            File(crashReports, "pending"),
+            // Crash event records (time, crash ID) for Gecko's crash manager.
+            File(crashReports, "events"),
+            // Where GeckoRuntime's crash helper writes child-process minidumps first.
+            File(root, "minidumps"),
+        )
+    }
+}
+
+/**
+ * Blackdrift: runs [onCleanUp] after a tab crash and whenever the browsing session ends with no tab left (the erase
+ * button, the notification's erase action, the erase shortcuts, removing the app from recents, or closing the
+ * last tab). Every Focus erase path ends in a tab list action that leaves the store empty.
+ */
+class CrashDumpCleanerMiddleware(
+    private val onCleanUp: () -> Unit,
+) : Middleware<BrowserState, BrowserAction> {
+    override fun invoke(
+        store: Store<BrowserState, BrowserAction>,
+        next: (BrowserAction) -> Unit,
+        action: BrowserAction,
+    ) {
+        next(action)
+
+        when (action) {
+            is CrashAction -> onCleanUp()
+            is TabListAction,
+            is CustomTabListAction -> {
+                if (store.state.tabs.isEmpty() && store.state.customTabs.isEmpty()) {
+                    onCleanUp()
+                }
+            }
+            else -> Unit
+        }
+    }
+}
