+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.focus.engine
+
+import java.io.File
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import mozilla.components.browser.state.action.CrashAction
+import mozilla.components.browser.state.action.TabListAction
+import mozilla.components.browser.state.state.BrowserState
+import mozilla.components.browser.state.state.createTab
+import mozilla.components.browser.state.store.BrowserStore
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Rule
+import org.junit.Test
+import org.junit.rules.TemporaryFolder
+
+class CrashDumpCleanerTest {
+
+    @get:Rule val tempFolder = TemporaryFolder()
+
+    @Test
+    fun `deleteCrashDumps removes pending dumps, events and minidumps but keeps the directories`() {
+        val filesDir = tempFolder.newFolder("files")
+        val pending = File(filesDir, "mozilla/Crash Reports/pending").apply { mkdirs() }
+        val events = File(filesDir, "mozilla/Crash Reports/events").apply { mkdirs() }
+        val minidumps = File(filesDir, "minidumps").apply { mkdirs() }
+        File(pending, "id.dmp").writeText("dump")
+        File(pending, "id.extra").writeText("{\"URL\":\"https://example.com\"}")
+        File(events, "id").writeText("event")
+        File(minidumps, "nested").apply { mkdirs() }.resolve("id.dmp").writeText("dump")
+        val installTime = File(filesDir, "mozilla/Crash Reports/InstallTime1").apply { writeText("1") }
+        val profileFile = File(filesDir, "mozilla/profile/prefs.js").apply {
+            parentFile!!.mkdirs()
+            writeText("prefs")
+        }
+
+        CrashDumpCleaner(CoroutineScope(Dispatchers.Unconfined)) { filesDir }.deleteCrashDumps()
+
+        listOf(pending, events, minidumps).forEach { dir ->
+            assertTrue(dir.isDirectory)
+            assertEquals(emptyList<String>(), dir.list()!!.toList())
+        }
+        assertTrue(installTime.exists())
+        assertTrue(profileFile.exists())
+    }
+
+    @Test
+    fun `deleteCrashDumps does nothing when Gecko never wrote a dump`() {
+        val filesDir = tempFolder.newFolder("files")
+
+        CrashDumpCleaner(CoroutineScope(Dispatchers.Unconfined)) { filesDir }.deleteCrashDumps()
+
+        assertFalse(File(filesDir, "mozilla").exists())
+        assertFalse(File(filesDir, "minidumps").exists())
+    }
+
+    @Test
+    fun `middleware cleans up after a tab crash`() {
+        var cleanUps = 0
+        val tab = createTab("https://example.com", id = "tab", private = true)
+        val store =
+            BrowserStore(
+                initialState = BrowserState(tabs = listOf(tab)),
+                middleware = listOf(CrashDumpCleanerMiddleware { cleanUps++ }),
+            )
+
+        store.dispatch(CrashAction.SessionCrashedAction("tab"))
+
+        assertEquals(1, cleanUps)
+    }
+
+    @Test
+    fun `middleware cleans up when the last tab is erased, not while tabs remain`() {
+        var cleanUps = 0
+        val first = createTab("https://example.com", id = "first", private = true)
+        val second = createTab("https://example.org", id = "second", private = true)
+        val store =
+            BrowserStore(
+                initialState = BrowserState(tabs = listOf(first, second)),
+                middleware = listOf(CrashDumpCleanerMiddleware { cleanUps++ }),
+            )
+
+        store.dispatch(TabListAction.RemoveTabAction("first"))
+        assertEquals(0, cleanUps)
+
+        store.dispatch(TabListAction.RemoveAllTabsAction())
+        assertEquals(1, cleanUps)
+    }
+}
