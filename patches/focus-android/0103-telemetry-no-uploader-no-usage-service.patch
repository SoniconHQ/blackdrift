@@ -0,0 +1,19 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.focus.telemetry
+
+import mozilla.components.service.glean.net.PingUploader
+import mozilla.telemetry.glean.net.CapablePingUploadRequest
+import mozilla.telemetry.glean.net.Incapable
+import mozilla.telemetry.glean.net.UploadResult
+
+/**
+ * Blackdrift: Glean uploader that never opens a connection. Every ping Glean hands
+ * it is reported as not uploadable (the same result ConceptFetchHttpUploader
+ * returns when it cannot send a request), so Glean discards it.
+ */
+object NoUploadPingUploader : PingUploader {
+    override fun upload(request: CapablePingUploadRequest): UploadResult = Incapable(0)
+}
