+++ b/app/src/main/res/values/blackdrift_strings.xml
@@ -0,0 +1,32 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- This Source Code Form is subject to the terms of the Mozilla Public
+   - License, v. 2.0. If a copy of the MPL was not distributed with this
+   - file, You can obtain one at http://mozilla.org/MPL/2.0/. -->
+<!-- Blackdrift-owned strings. They replace upstream translatable strings that hard-code
+     Mozilla, Firefox or Focus. They are English only on purpose: overriding the
+     upstream keys would leave ~100 values-*/strings.xml translations still saying
+     Mozilla. Kept in main (not src/focus) so Klar variants still compile. -->
+<resources xmlns:tools="http://schemas.android.com/tools">
+    <!-- About screen body; replaces about_content. %1$s is the app name. -->
+    <string name="blackdrift_about_content" translatable="false" tools:ignore="BrandUsage,IncorrectStraightDoubleQuote"><![CDATA[<p>%1$s puts you in control.</p>
+<p>Use it as a private browser:
+  <ul>
+    <li>Search and browse right in the app</li>
+    <li>Block trackers (or update settings to allow trackers)</li>
+    <li>Erase to delete cookies as well as search and browsing history</li>
+  </ul>
+</p>
+<p>Blackdrift is made by Sonicon. Blackdrift is based on Firefox Focus by Mozilla. Not affiliated with or endorsed by Mozilla.</p>]]></string>
+
+    <!-- Onboarding first screen; replaces onboarding_first_screen_privacy_notice_text_2.
+         %1$s is the (translated) "Privacy Notice" link text. -->
+    <string name="blackdrift_onboarding_privacy_notice_text" translatable="false">Blackdrift cares about your privacy. Learn more in our %1$s.</string>
+
+    <!-- Text-selection menu action in other apps; replaces text_selection_search_action_focus. -->
+    <string name="blackdrift_text_selection_search_action" translatable="false">Search in Blackdrift</string>
+
+    <!-- Autocomplete "add URL" hint; replaces preference_autocomplete_add_example2
+         ("Example: mozilla.org"). Upstream deleted the neutral
+         preference_autocomplete_add_example key after Firefox 150. -->
+    <string name="blackdrift_autocomplete_add_example" translatable="false">Example: example.com</string>
+</resources>
